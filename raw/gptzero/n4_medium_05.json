          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9998674355935724,
          "sentence": "It also reminds teachers, employers, and peers to create environments where people can build communication skills gradually and safely.",
          "perplexity": 0,
          "class_probabilities": {
