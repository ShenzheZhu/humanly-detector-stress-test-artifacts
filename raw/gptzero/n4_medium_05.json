          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9998708108724303,
          "sentence": "It can range from mild nervousness to intense panic that makes one avoid presentations.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0001291891275696836,
            "ai": 0.9994680629330434,
            "paraphrased": 0.00040274793938695826
