        {
          "generated_prob": 0.9998331493012785,
          "sentence": "Public speaking anxiety is the fear people feel when they have to speak in front of others.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00016685069872152572,
            "ai": 0.999405835551961,
            "paraphrased": 0.000427313749317431
