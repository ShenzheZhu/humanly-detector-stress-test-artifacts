        },
        {
          "generated_prob": 0.0071892946623275476,
          "sentence": "Although these concepts may sound familiar, they are notably difficult to define.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9928107053376725,
            "ai": 0.00048616722495168263,
            "paraphrased": 0.006703127437375865
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
