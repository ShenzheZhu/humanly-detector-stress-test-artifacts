          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00010693318082497706,
          "sentence": "- Although the method is generally explained well, some training details are missing.",
          "perplexity": 0,
          "class_probabilities": {
