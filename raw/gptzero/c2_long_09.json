          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00009282178156847372,
          "sentence": "Other major points (good and bad):",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999071782184316,
