      "sentences": [
        {
          "generated_prob": 0.9999860946408146,
          "sentence": "Mindsets are the beliefs people hold about themselves, their abilities, and the meaning of success or failure.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000013905359185421242,
            "ai": 0.9999741389599788,
            "paraphrased": 0.000011955680835817994
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999890699986971,
          "sentence": "In plain language, a mindset is the “story” a person tells themselves about what they can do and why outcomes happen.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000010930001302872754,
            "ai": 0.9999748904508996,
            "paraphrased": 0.000014179547797482588
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999868761500325,
          "sentence": "For example, a student might believe that they are simply “bad at maths,” or they might believe that maths is difficult now but can improve with practice, feedback, and better strategies.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000013123849967538602,
            "ai": 0.9999741759700006,
            "paraphrased": 0.000012700180031806292
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999889194196458,
          "sentence": "These two interpretations can lead to very different emotions, choices, and learning outcomes.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000011080580354159353,
            "ai": 0.9999742460250991,
            "paraphrased": 0.00001467339454672346
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999885667604942,
          "sentence": "A useful way to understand mindsets is through the difference between fixed and growth views of ability.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000011433239505826442,
            "ai": 0.9999749088704345,
            "paraphrased": 0.00001365789005970909
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999912306626546,
          "sentence": "A fixed mindset treats intelligence, talent, or personality as mostly unchangeable.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008769337345441895,
            "ai": 0.9999739324929331,
            "paraphrased": 0.000017298169721477692
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999910131315435,
          "sentence": "From this perspective, effort can feel threatening because needing to try hard may seem like proof of low ability.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008986868456595756,
            "ai": 0.9999723984246424,
            "paraphrased": 0.000018614706901074493
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999920723148387,
          "sentence": "Failure can also feel deeply personal, as if one poor result reveals something permanent about the self.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007927685161350159,
            "ai": 0.99997067637918,
            "paraphrased": 0.000021395935658676234
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999913777498722,
          "sentence": "In contrast, a growth mindset sees ability as something that can develop over time.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008622250127714307,
            "ai": 0.999973101227868,
            "paraphrased": 0.000018276522004284788
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999913618992424,
          "sentence": "This does not mean everyone can become equally skilled at everything, but it does mean improvement is possible through effort, guidance, persistence, and adaptation.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008638100757658694,
            "ai": 0.9999720234241161,
            "paraphrased": 0.000019338475126328665
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999899547743317,
          "sentence": "Mindsets are closely connected to motivation because they influence what people think is worth doing.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000010045225668350822,
            "ai": 0.9999734835678421,
            "paraphrased": 0.00001647120648957375
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999911508796072,
          "sentence": "If someone believes their ability is fixed, they may avoid difficult tasks to protect their self-image.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008849120392734103,
            "ai": 0.9999736308415714,
            "paraphrased": 0.000017520038035841754
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999914742117764,
          "sentence": "They might choose easy work, give up quickly, or compare themselves constantly with others.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008525788223601043,
            "ai": 0.9999739238666004,
            "paraphrased": 0.000017550345175956865
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999898554468309,
          "sentence": "Their motivation may depend heavily on looking competent.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000010144553169060156,
            "ai": 0.9999739082246087,
            "paraphrased": 0.00001594722222221581
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999909381308952,
          "sentence": "A growth mindset tends to support more resilient motivation.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000009061869104808613,
            "ai": 0.9999740575501268,
            "paraphrased": 0.000016880580768422267
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999912473177522,
          "sentence": "Challenges can be interpreted as opportunities to learn rather than as threats.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00000875268224773306,
            "ai": 0.9999735257299885,
            "paraphrased": 0.0000177215877637449
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999909305717349,
          "sentence": "Mistakes become information rather than evidence of failure.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000009069428264998518,
            "ai": 0.9999743534212644,
            "paraphrased": 0.00001657715047055298
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999908445126441,
          "sentence": "This can encourage persistence, curiosity, and a willingness to seek help.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000009155487355872373,
            "ai": 0.9999742116230941,
            "paraphrased": 0.000016632889550050166
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999878148959036,
          "sentence": "Mindsets also shape emotion.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000012185104096364159,
            "ai": 0.9999741046856487,
            "paraphrased": 0.000013710210254891372
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999904490082424,
          "sentence": "A person with a fixed mindset may feel shame, anxiety, or defensiveness when they struggle, because struggle seems to signal inadequacy.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000009550991757679136,
            "ai": 0.9999751563194107,
            "paraphrased": 0.00001529268883167766
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9992207048164768,
          "sentence": "A person with a growth mindset may still feel frustration or disappointment, but those emotions are more likely to be temporary and manageable.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0007792951835231735,
            "ai": 0.9992064763420992,
            "paraphrased": 0.000014228474377543738
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999527422826588,
          "sentence": "The emotional meaning of difficulty changes: it becomes part of the learning process rather than a final judgment.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00004725771734113388,
            "ai": 0.9999442853601881,
            "paraphrased": 0.000008456922470722003
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999974953340722,
          "sentence": "This emotional difference matters because feelings strongly affect attention, memory, and decision-making.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00002504665927810768,
            "ai": 0.9999650394786275,
            "paraphrased": 0.000009913862094435638
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999452273586108,
          "sentence": "When people are overwhelmed by fear of failure, they may focus more on avoiding embarrassment than on understanding the task.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00005477264138918648,
            "ai": 0.9999361053386504,
            "paraphrased": 0.000009122019960363696
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999368140634574,
          "sentence": "A concrete example can be seen in a first-year university student receiving a low mark on an essay.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00006318593654263352,
            "ai": 0.9999275198961807,
            "paraphrased": 0.000009294167276724864
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999644199569027,
          "sentence": "With a fixed mindset, the student might think, “I am not academic enough for university,” and avoid reading the feedback because it feels painful.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00003558004309738962,
            "ai": 0.9999552735718029,
            "paraphrased": 0.000009146385099707777
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999476484658051,
          "sentence": "They may put less effort into the next assignment or consider dropping the course.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00005235153419493695,
            "ai": 0.9999383093727656,
            "paraphrased": 0.000009339093039457096
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999718305024607,
          "sentence": "With a growth mindset, the student might think, “This result shows that my argument and structure need work.” They may meet with a tutor, study examples of strong essays, revise their planning process, and improve over time.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000028169497539201385,
            "ai": 0.9999620944471416,
            "paraphrased": 0.00000973605531919837
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999698550713056,
          "sentence": "The same event—a disappointing grade—can therefore lead either to withdrawal or to constructive action.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000030144928694370366,
            "ai": 0.9999604713283392,
            "paraphrased": 0.000009383742966423826
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999782210000978,
          "sentence": "This topic matters because mindsets influence everyday choices in education, work, relationships, health, and personal development.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00002177899990218622,
            "ai": 0.9999680366177358,
            "paraphrased": 0.000010184382362012557
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999695879138782,
          "sentence": "They affect whether people take risks, respond to criticism, recover from setbacks, and pursue long-term goals.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000030412086121768045,
            "ai": 0.9999604913602416,
            "paraphrased": 0.000009096553636702044
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9998875581118517,
          "sentence": "Understanding mindsets can help individuals become more aware of the assumptions guiding their behaviour.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00011244188814829807,
            "ai": 0.9998787275006978,
            "paraphrased": 0.000008830611153908692
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999589520868368,
          "sentence": "It can also help teachers, parents, managers, and peers create environments where effort, strategy, and improvement are valued.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00004104791316308814,
            "ai": 0.9999498837711718,
            "paraphrased": 0.000009068315665098248
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999253878112233,
          "sentence": "A growth-oriented approach does not remove difficulty or guarantee success, but it can make people more willing to engage with challenges and learn from them.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00007461218877670656,
            "ai": 0.9999166865261341,
            "paraphrased": 0.000008701285089250384
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9993848683562377,
          "sentence": "In this way, mindset is not just a private belief; it is a powerful factor in motivation, emotion, and the direction of human behaviour.",
          "perplexity": 0,
