          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999897988996908,
          "sentence": "Some motivation comes from outside rewards, such as earning a qualification, getting a job, or receiving recognition.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000010201100309181855,
