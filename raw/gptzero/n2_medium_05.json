          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999261986417517,
          "sentence": "By the end, she sees that she was able to speak even while feeling anxious.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00007380135824836644,
            "ai": 0.9999180482563614,
            "paraphrased": 0.000008150385390238905
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999923725967989,
          "sentence": "The fear is not gone, but she now has evidence that she can manage it.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00007627403201107955,
            "ai": 0.999915374442741,
            "paraphrased": 0.000008351525247904481
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999693510945713,
          "sentence": "Public speaking anxiety matters because speaking to others is part of education, work, and civic life.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00003064890542865952,
            "ai": 0.9999600618440433,
            "paraphrased": 0.000009289250528044138
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999962977004444,
          "sentence": "Students present assignments, employees share ideas in meetings, and community members speak up for issues they care about.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00003702299555595059,
            "ai": 0.9999537985989885,
            "paraphrased": 0.000009178405455542046
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
