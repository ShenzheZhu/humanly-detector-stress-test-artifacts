          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999578511575369,
          "sentence": "When anxiety keeps people silent, it can limit achievement, confidence, and participation.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000042148842463195556,
            "ai": 0.9999487914793478,
            "paraphrased": 0.000009059678189049669
          },
