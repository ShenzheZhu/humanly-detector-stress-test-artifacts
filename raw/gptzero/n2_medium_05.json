      "sentences": [
        {
          "generated_prob": 0.999991450215572,
          "sentence": "Public speaking anxiety is the fear or discomfort people feel when they have to speak in front of others.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00000854978442800732,
            "ai": 0.9999740542405613,
            "paraphrased": 0.00001739597501072141
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999915042697287,
          "sentence": "It can be as mild as a few nerves before a presentation or as intense as panic that leads someone to avoid speaking altogether.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00000849573027124515,
            "ai": 0.9999736782641042,
            "paraphrased": 0.00001782600562450612
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999921872191407,
          "sentence": "In simple terms, it is the feeling that being watched and judged while speaking is dangerous, even when there is no real threat.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007812780859345318,
            "ai": 0.999973105277261,
            "paraphrased": 0.000019081941879670458
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999933596370166,
          "sentence": "The body may respond as if the situation is unsafe: the heart beats faster, breathing becomes shallow, the voice shakes, and thoughts are harder to organize.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000006640362983405052,
            "ai": 0.9999697636963676,
            "paraphrased": 0.000023595940649000037
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999926295045077,
          "sentence": "At the same time, the person may worry about making mistakes, looking foolish, forgetting what to say, or being judged negatively.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007370495492264354,
            "ai": 0.9999713893034956,
            "paraphrased": 0.000021240201012090582
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999911851141825,
          "sentence": "This anxiety is tied closely to emotion.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00000881488581750969,
            "ai": 0.9999732247375699,
            "paraphrased": 0.00001796037661257454
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999913917970864,
          "sentence": "It involves fear, embarrassment, and self-consciousness, and these feelings affect both the body and the way a person understands the situation.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008608202913598003,
            "ai": 0.999973437221697,
            "paraphrased": 0.000017954575389440342
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999921595539787,
          "sentence": "A student who feels anxious before a class presentation may see neutral facial expressions as signs of boredom or criticism.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007840446021389618,
            "ai": 0.9999725284788035,
            "paraphrased": 0.000019631075175164666
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999927335565205,
          "sentence": "That interpretation can increase fear and make the task feel even harder.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007266443479492089,
            "ai": 0.9999708060246167,
            "paraphrased": 0.000021927531903720473
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999921993111309,
          "sentence": "Anxiety also affects attention.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007800688869141014,
            "ai": 0.9999710483209855,
            "paraphrased": 0.00002115099014542264
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999939862039317,
          "sentence": "Instead of focusing on the message, the speaker may become absorbed in trembling hands, an awkward pause, or the thought of failing.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0000060137960683710145,
            "ai": 0.9999670535095176,
            "paraphrased": 0.00002693269441395116
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999927609813726,
          "sentence": "This can create a cycle: anxiety makes speaking harder, and small difficulties then feed the anxiety.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007239018627366072,
            "ai": 0.9999707567393271,
            "paraphrased": 0.00002200424204547064
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999914572961233,
          "sentence": "Public speaking anxiety also affects motivation and behavior.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008542703876803613,
            "ai": 0.9999733232227612,
            "paraphrased": 0.000018134073362020146
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999933675538382,
          "sentence": "Some nervousness can push a person to prepare carefully, rehearse, and feel more in control.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000006632446161824529,
            "ai": 0.9999698641183409,
            "paraphrased": 0.000023503435497338314
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999903980105367,
          "sentence": "In that sense, a moderate level of anxiety can be useful.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000009601989463323662,
            "ai": 0.9999742324299794,
            "paraphrased": 0.00001616558055730296
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999910735747358,
          "sentence": "When the anxiety becomes too strong, though, it can make the task seem impossible.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0000089264252642349,
            "ai": 0.9999741695364011,
            "paraphrased": 0.000016904038334728756
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999922845118949,
          "sentence": "A person may put off preparing, avoid courses that require presentations, or decide not to seek leadership roles.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00000771548810511443,
            "ai": 0.9999723299528437,
            "paraphrased": 0.00001995455905123355
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999893043505148,
          "sentence": "Avoidance can bring short-term relief, but it often strengthens the fear because the person does not get the chance to learn that they can cope.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000010695649485160347,
            "ai": 0.9999737376998424,
            "paraphrased": 0.00001556665067240302
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9884980866218478,
          "sentence": "Learning plays a major role in how public speaking anxiety develops and how it can be reduced.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.011501913378152203,
            "ai": 0.9884575369628003,
            "paraphrased": 0.000040549659047490546
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9985404799661084,
          "sentence": "Someone who once had a humiliating experience while speaking may begin to associate presentations with danger.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0014595200338915195,
            "ai": 0.9985244572983798,
            "paraphrased": 0.000016022667728650208
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9984879621811406,
          "sentence": "They may expect future speaking situations to go badly, even if that earlier event was unusual.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0015120378188593884,
            "ai": 0.9984720322123164,
            "paraphrased": 0.00001592996882418963
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9980480265701673,
          "sentence": "Repeated manageable experiences can have the opposite effect.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0019519734298326886,
            "ai": 0.998029833202501,
            "paraphrased": 0.000018193367666312584
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9998412573927509,
          "sentence": "Practicing in small groups, receiving supportive feedback, and gradually speaking to larger audiences can help a person learn that anxiety is uncomfortable but not harmful.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00015874260724908722,
            "ai": 0.9998317870646096,
            "paraphrased": 0.000009470328141238066
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999933759070567,
          "sentence": "They can also build practical skills, such as organizing ideas clearly, pausing instead of rushing, and making eye contact in a relaxed way.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00006624092943298818,
            "ai": 0.9999251385741761,
            "paraphrased": 0.000008620496390934983
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999893868672377,
          "sentence": "Imagine a first-year university student who has to give a five-minute presentation in a tutorial.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00010613132762311901,
            "ai": 0.9998854123927801,
            "paraphrased": 0.000008456279596856023
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999624691736648,
          "sentence": "Before class, she feels sick and thinks about staying home.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00003753082633520628,
            "ai": 0.9999530304640353,
            "paraphrased": 0.000009438709629497686
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999772162778869,
          "sentence": "She worries that everyone will notice her nerves and assume she is unprepared.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000022783722113139506,
            "ai": 0.9999669545740185,
            "paraphrased": 0.000010261703868394368
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999801375478483,
          "sentence": "Instead, she practices with a friend, writes brief cue cards, and reminds herself that the audience is mostly trying to understand the topic, not judge her personally.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000019862452151632345,
            "ai": 0.9999692942267796,
            "paraphrased": 0.000010843321068751465
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999464099084286,
          "sentence": "Her voice shakes at the start, but she keeps going.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000053590091571305206,
            "ai": 0.9999371905560505,
            "paraphrased": 0.000009219352378222499
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
