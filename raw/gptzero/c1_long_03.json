        },
        {
          "generated_prob": 0.015351724909611309,
          "sentence": "- Generally the paper does not succeed in telling a complete story about the properties and applicability of the proposed method.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9846482750903887,
