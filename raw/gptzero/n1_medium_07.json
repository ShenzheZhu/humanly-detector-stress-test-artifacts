          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999729527630389,
          "sentence": "Checking prices online before buying, reading reviews, waiting for sales, or using wish lists can become routine behaviors shaped by past outcomes.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00002704723696116533,
