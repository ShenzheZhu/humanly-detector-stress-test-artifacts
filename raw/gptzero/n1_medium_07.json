          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999919753714345,
          "sentence": "Others are emotional, such as feeling excited by a sale, comforted by shopping from home, or rewarded by receiving a package.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008024628565509137,
            "ai": 0.9999740654374238,
            "paraphrased": 0.000017909934010633688
