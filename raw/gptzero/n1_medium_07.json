          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999924968676066,
          "sentence": "Online shopping is therefore not only a matter of convenience; it is also connected to how people regulate mood, make decisions, learn from experience, and respond to digital environments.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007503132393355768,
            "ai": 0.9999733348448844,
            "paraphrased": 0.000019162022722284622
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999992625269569,
          "sentence": "Motivation plays a central role because online shopping can satisfy both needs and wants.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00000737473043100045,
            "ai": 0.9999726263332936,
            "paraphrased": 0.00001999893627533128
