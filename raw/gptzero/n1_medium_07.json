          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999935606802669,
          "sentence": "They may feel anxious about spending a large amount of money, excited about getting a new device, and reassured by positive reviews.",
          "perplexity": 0,
          "class_probabilities": {
