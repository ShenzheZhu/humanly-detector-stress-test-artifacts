          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999933820174755,
          "sentence": "Digital stores are designed to reduce effort and encourage action.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0000066179825245411945,
            "ai": 0.9999707072424334,
            "paraphrased": 0.00002267477504207192
