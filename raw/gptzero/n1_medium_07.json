          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999886361976065,
          "sentence": "In this way, emotion and motivation interact: excitement, fear of missing out, and anticipated regret can speed up decisions that might otherwise require more thought.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000011363802393512078,
