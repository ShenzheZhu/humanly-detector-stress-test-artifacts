          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999921447349498,
          "sentence": "A person may shop online because they need a replacement phone charger quickly, but they may also browse clothing websites because they are bored, stressed, or seeking pleasure.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007855265050192906,
