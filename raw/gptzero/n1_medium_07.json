          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999667631746615,
          "sentence": "A concrete example is a university student buying a laptop online before the semester begins.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000033236825338435675,
            "ai": 0.9999536256701482,
