          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9998554898298337,
          "sentence": "A positive experience, such as fast delivery and an easy return process, can reinforce future online shopping.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0001445101701662213,
            "ai": 0.9998364912563297,
