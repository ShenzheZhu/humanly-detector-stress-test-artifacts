          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999922890245609,
          "sentence": "Some motivations are practical, such as saving time, finding lower prices, or accessing products that are not available locally.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007710975439017359,
            "ai": 0.9999736732283645,
