          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999373552160232,
          "sentence": "Consumers gradually learn which websites they trust, which brands fit their needs, and which cues signal quality or risk.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000062644783976724,
            "ai": 0.9999216241908404,
