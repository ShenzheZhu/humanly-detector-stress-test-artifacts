            "paraphrased": 0.000018578869111979248
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999907763923677,
          "sentence": "This shows the difference between goal-directed and emotion-driven motivation.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000009223607632402918,
