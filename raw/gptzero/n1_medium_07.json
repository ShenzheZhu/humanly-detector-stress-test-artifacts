          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999899318177807,
          "sentence": "In plain language, it is about what pushes or pulls a person toward buying online.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000010068182219262409,
            "ai": 0.9999750329247369,
