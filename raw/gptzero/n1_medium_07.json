          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999924895961017,
          "sentence": "Goal-directed shopping is usually planned and purposeful.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007510403898367498,
