          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999917921798516,
          "sentence": "Emotion-driven shopping may be less planned.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008207820148386753,
