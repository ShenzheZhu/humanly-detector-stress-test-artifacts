        {
          "generated_prob": 0.9999913723899491,
          "sentence": "Online shopping motivation refers to the reasons people choose to search for, compare, and buy products through digital platforms rather than in physical stores.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00000862761005094553,
