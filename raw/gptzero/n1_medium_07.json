          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999914145100166,
          "sentence": "Online shopping also affects decision-making.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008585489983349022,
