          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999906007453396,
          "sentence": "These features can help consumers make informed decisions, but they can also create pressure.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000009399254660353958,
