          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999830129782848,
          "sentence": "The student is motivated by a practical need: they require a reliable device for lectures, assignments, and exams.",
          "perplexity": 0,
          "class_probabilities": {
