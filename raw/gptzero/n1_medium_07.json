          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9998953414408146,
          "sentence": "Learning is also involved.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000104658559185446,
