          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999924654400202,
          "sentence": "Search filters, customer reviews, personalized recommendations, free shipping thresholds, countdown timers, and “only a few left” messages all influence how people evaluate choices.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007534559979831625,
