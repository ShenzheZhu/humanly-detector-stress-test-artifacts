          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.99999247403726,
          "sentence": "The act of browsing, imagining ownership, adding items to a cart, or finding discounts can create enjoyment before any purchase is actually made.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007525962740070829,
