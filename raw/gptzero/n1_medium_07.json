          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999907372900924,
          "sentence": "For example, a limited-time discount may make someone feel that delaying a purchase means losing an opportunity.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00000926270990758138,
            "ai": 0.9999751096186931,
