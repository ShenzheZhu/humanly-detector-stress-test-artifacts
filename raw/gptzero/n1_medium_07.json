          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9998995411971539,
          "sentence": "A negative experience, such as receiving a poor-quality item or dealing with hidden fees, can reduce motivation to buy from that seller again.",
