          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999743331548832,
          "sentence": "They compare models, read reviews, watch video demonstrations, and look for student discounts.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000025666845116777237,
