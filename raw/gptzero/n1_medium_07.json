          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999914223173824,
          "sentence": "The shopper has a problem to solve and uses online tools to solve it efficiently.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008577682617727564,
