          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999487778903762,
          "sentence": "Understanding grit helps explain why some people continue developing after early failure while others withdraw despite having ability.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00005122210962382395,
            "ai": 0.9999398904019282,
