        },
        {
          "generated_prob": 0.9999926740634131,
          "sentence": "In plain language, it is “sticking with it” because the goal matters enough to justify repeated effort.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007325936586892325,
            "ai": 0.9999728155195429,
            "paraphrased": 0.00001985854387022367
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
