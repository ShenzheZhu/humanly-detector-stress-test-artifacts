            "paraphrased": 0.000009405474646171046
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999610570304694,
          "sentence": "Wise grit includes reflection: knowing when to persist, when to change strategy, and when to redirect effort.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00003894296953063452,
            "ai": 0.9999519286350603,
            "paraphrased": 0.000009128395409064506
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999425899698806,
          "sentence": "This topic matters because many important outcomes in life require sustained effort rather than quick achievement.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00005741003011938838,
            "ai": 0.9999338969371615,
            "paraphrased": 0.000008693032719105343
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999339971804827,
          "sentence": "Education, careers, relationships, health, and personal growth all involve obstacles.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00006600281951730411,
            "ai": 0.999925065930254,
            "paraphrased": 0.000008931250228694813
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
