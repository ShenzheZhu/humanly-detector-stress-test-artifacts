          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999930500996667,
          "sentence": "Grit is not the same as raw talent, momentary enthusiasm, or stubbornness in every situation.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000006949900333342539,
            "ai": 0.9999714734373036,
            "paraphrased": 0.000021576662363052716
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999912157448326,
          "sentence": "A gritty person is not someone who never feels bored, tired, or disappointed.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008784255167321344,
            "ai": 0.9999731309488793,
            "paraphrased": 0.000018084795953342284
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999932747879763,
          "sentence": "Rather, grit involves continuing to act in line with a valued aim despite those feelings, while learning from setbacks and adjusting methods when necessary.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000006725212023651648,
            "ai": 0.9999712977127322,
            "paraphrased": 0.000021977075244146796
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999932449250976,
          "sentence": "Grit is closely connected to motivation because it depends on both direction and endurance.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000006755074902464984,
            "ai": 0.9999710862332726,
            "paraphrased": 0.00002215869182499609
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999935583293902,
          "sentence": "Many people can feel motivated for a short period, especially when a goal is new and exciting.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000006441670609712937,
            "ai": 0.9999702798515593,
            "paraphrased": 0.0000232784778309486
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999932415946796,
          "sentence": "The harder challenge is maintaining effort after the novelty fades.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000006758405320332647,
            "ai": 0.9999709445473763,
            "paraphrased": 0.000022297047303316195
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999941035038424,
          "sentence": "Grit helps bridge the gap between initial desire and sustained action.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000005896496157614286,
            "ai": 0.9999682268496306,
            "paraphrased": 0.000025876654211832237
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999928344783885,
          "sentence": "It is supported by intrinsic motivation when a person finds personal meaning in the goal, but it can also involve external motives such as wanting to qualify for a profession, support a family, or contribute to a community.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007165521611559984,
            "ai": 0.9999722027843342,
            "paraphrased": 0.000020631694054255192
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999910558297667,
          "sentence": "What matters is that the goal remains important enough to organise behaviour over time.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008944170233403072,
            "ai": 0.9999725993970713,
            "paraphrased": 0.00001845643269536737
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999925435696517,
          "sentence": "Emotion also plays a central role.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007456430348307404,
            "ai": 0.9999722111003929,
            "paraphrased": 0.000020332469258789285
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999937908944112,
          "sentence": "Long-term effort inevitably involves frustration, self-doubt, disappointment, and sometimes envy of people who appear to progress faster.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000006209105588787792,
            "ai": 0.9999701213792743,
            "paraphrased": 0.000023669515136850257
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999929016439084,
          "sentence": "Grit does not remove these emotions; it changes how a person responds to them.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007098356091574513,
            "ai": 0.9999720576663935,
            "paraphrased": 0.00002084397751487403
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999925510999537,
          "sentence": "Instead of interpreting failure as proof that they should quit, a gritty learner may see it as information about what needs more practice.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007448900046430335,
            "ai": 0.9999727244611438,
            "paraphrased": 0.000019826638809795588
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999893358802071,
          "sentence": "This emotional regulation is important because giving up often occurs not when a task is impossible, but when the discomfort associated with it becomes too strong.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000010664119792815414,
            "ai": 0.999973153365067,
            "paraphrased": 0.000016182515140159268
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999876165914282,
          "sentence": "Grit therefore involves tolerating temporary discomfort for the sake of a larger purpose.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000012383408571689149,
            "ai": 0.9999717265460715,
            "paraphrased": 0.000015890045356784902
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999836433639708,
          "sentence": "In learning, grit can influence study habits, skill development, and academic achievement.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000016356636029113268,
            "ai": 0.9999685012416673,
            "paraphrased": 0.000015142122303624686
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999386650717017,
          "sentence": "A student who is gritty is more likely to revise after receiving poor feedback, attend practice sessions consistently, and seek help rather than avoid difficult material.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00006133492829832011,
            "ai": 0.9999298280279038,
            "paraphrased": 0.000008837043797965253
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999460585159767,
          "sentence": "For example, imagine a first-year university student who wants to become a nurse but struggles with anatomy.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00005394148402332782,
            "ai": 0.9999373111404115,
            "paraphrased": 0.000008747375565196588
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999679182058272,
          "sentence": "After failing the first quiz, she feels embarrassed and considers changing courses.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000032081794172856546,
            "ai": 0.9999585701106549,
            "paraphrased": 0.00000934809517223239
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999978530078239,
          "sentence": "Instead, she reviews her mistakes, forms a weekly study group, asks her tutor for guidance, and uses diagrams and flashcards every evening.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000021469921760998012,
            "ai": 0.9999684359564373,
            "paraphrased": 0.000010094121801752453
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999794175882332,
          "sentence": "Her improvement is not immediate, and she still finds the subject challenging, but over the semester her understanding grows.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00002058241176681248,
            "ai": 0.9999696487024531,
            "paraphrased": 0.000009768885780075126
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999811524979835,
          "sentence": "In this case, grit is shown not by effortless success, but by repeated, purposeful action after a setback.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000018847502016483526,
            "ai": 0.9999706562581095,
            "paraphrased": 0.000010496239873917585
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999747777046171,
          "sentence": "Grit also affects decision-making.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000025222295382949037,
            "ai": 0.9999653480568247,
            "paraphrased": 0.000009429647792407258
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999810157963253,
          "sentence": "People often face choices between short-term comfort and long-term benefit: watching television or studying, sleeping in or attending training, avoiding feedback or confronting weaknesses.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000018984203674642896,
            "ai": 0.9999704922766295,
            "paraphrased": 0.000010523519695824248
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999682778593321,
          "sentence": "Grit makes it more likely that decisions will align with future goals rather than immediate moods.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0000317221406679157,
            "ai": 0.9999590688493359,
            "paraphrased": 0.000009209009996107758
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999602710581599,
          "sentence": "However, it should be balanced with flexibility.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00003972894184012309,
            "ai": 0.9999511864571617,
            "paraphrased": 0.000009084600998163184
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999427421695087,
          "sentence": "Persisting with a goal can be admirable, but continuing at any cost may be harmful if the goal becomes unrealistic, damaging, or no longer meaningful.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00005725783049123748,
