        {
          "generated_prob": 0.9999928785300988,
          "sentence": "Grit is the capacity to keep working toward a meaningful long-term goal even when progress is slow, difficult, or discouraging.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007121469901269907,
            "ai": 0.9999729348047727,
