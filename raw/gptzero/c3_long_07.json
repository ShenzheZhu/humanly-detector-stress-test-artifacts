        {
          "generated_prob": 0.00009880034724495747,
          "sentence": "# 1960s Tristesse",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.999901199652755,
            "ai": 0.00006246060516691947,
            "paraphrased": 0.00003633974207803799
