          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00006089245614280311,
          "sentence": "In “I’m Going to Make You So Happy” we are introduced to eight families who live in one stairwell of an apartment block in Trondheim in the mid-1960s.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999391075438572,
            "ai": 0.000028273868092868736,
            "paraphrased": 0.000032618588049934375
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00005218750038842985,
          "sentence": "Outwardly fairly similar, but highly different once we get to know them, as it turns out.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999478124996116,
            "ai": 0.000019061999908890342,
            "paraphrased": 0.000033125500479539504
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00006381739833909338,
          "sentence": "While the men are at work, a teeming life goes on among the stay-at-home wives in the block.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.999936182601661,
            "ai": 0.00002906133205894271,
            "paraphrased": 0.00003475606628015066
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00007019681774838075,
          "sentence": "Sound carries so much, so very much, between the flats that it is barely possible to have a private life.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999298031822517,
            "ai": 0.000034296063548217766,
            "paraphrased": 0.00003590075420016299
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00007356446349373607,
          "sentence": "This bothers the women, who want to have something to themselves.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999264355365063,
            "ai": 0.00003942954523639434,
            "paraphrased": 0.00003413491825734173
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.000057241829067544587,
          "sentence": "Everyone keeps watch on everyone else, and is hungry for news in a time when, basically, nothing ever happens.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999427581709325,
            "ai": 0.000024963855515488216,
            "paraphrased": 0.00003227797355205637
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.0000725756197630462,
          "sentence": "We get a tiny glimpse into the men’s world, but most of all this is about the women; the first generation of women who had moved far away from their home places, and who had to create something entirely their own from scratch, almost without role models.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.999927424380237,
            "ai": 0.00003790712521724684,
            "paraphrased": 0.00003466849454579936
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00005220803934495758,
          "sentence": "Who are in the phase of establishing themselves, and who fill their weekdays with children, cleaning, gossiping and weekly magazines ...",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999477919606551,
            "ai": 0.000022503489289462412,
            "paraphrased": 0.00002970455005549517
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00005880266498895145,
          "sentence": "At a time when the housewife role was associated with both pride and honor, and when everything was supposed to be spotlessly clean, preferably gleaming, and when all food was made from scratch to save a few øre here and a few øre there—in order to stretch the tight household budgets as far as possible—no one talked about the oppression of women.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999411973350111,
            "ai": 0.00002649175717462134,
            "paraphrased": 0.000032310907814330105
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00007071860375784104,
          "sentence": "If anything, it had to be the women themselves who oppressed one another, as they gossiped about anyone and everyone who was the slightest bit different from themselves.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999292813962422,
            "ai": 0.000036773693599164704,
            "paraphrased": 0.00003394491015867634
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00008489334002296779,
          "sentence": "Well, if it was to be acceptable to be different, one had to be different in the right way.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999151066599771,
            "ai": 0.00005081777916322538,
            "paraphrased": 0.00003407556085974241
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00010918840496469898,
          "sentence": "But pity the person who did not iron all her clothes, who did not take the stair cleaning seriously enough, who did not make food from scratch—then she really got it!",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9998908115950353,
            "ai": 0.00007362690720708207,
            "paraphrased": 0.00003556149775761692
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.0003857422198770883,
          "sentence": "One married couple in the block has just had a little baby, but everything is not as it should be.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9996142577801229,
            "ai": 0.00019187858926552977,
            "paraphrased": 0.0001938636306115585
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00022852452179099428,
          "sentence": "The baby no longer cries, the mother is clearly in a postnatal depression, and she and her husband communicate extremely badly.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.999771475478209,
            "ai": 0.000058419234983744984,
            "paraphrased": 0.0001701052868072493
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00023366948492248852,
          "sentence": "Another married couple is not quite like the others, because the husband is a translator and in that sense has a free profession where he can come and go as he pleases, while the wife, who is English, runs a hairdressing salon in the kitchen to supplement their income.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9997663305150775,
            "ai": 0.00007438954484910773,
            "paraphrased": 0.00015927994007338078
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00018803145974983387,
          "sentence": "At the top of the block towers the Foss family; he a travelling salesman in Toro soup packets, she a tasty morsel of a woman who is slim, always tanned and with red-painted nails, but who is bored to death while her husband is away travelling, since they have not yet had children for her to fill her days with.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9998119685402501,
            "ai": 0.00004231128422015119,
            "paraphrased": 0.00014572017552968267
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00021574870573089287,
          "sentence": "The way to a highball glass or two to make the long days more bearable is not far ...",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9997842512942691,
            "ai": 0.000049600634015902746,
            "paraphrased": 0.00016614807171499012
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00018952660588723573,
          "sentence": "And then we have little Nina, Karlsen’s motherless daughter, who does not have her own key to the flat and always wanders around almost like a homeless person, smelling of pee from her dirty clothes because her father never manages these housewife things, and does not have all the understanding in the world for a small child’s needs either.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9998104733941128,
            "ai": 0.00004287383667527235,
            "paraphrased": 0.00014665276921196338
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.0002154636765097055,
          "sentence": "But little Nina has talents in mathematics that are completely unique.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9997845363234903,
            "ai": 0.00006137299395066503,
            "paraphrased": 0.0001540906825590405
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00025655304187601575,
          "sentence": "We sense a neglected dandelion child, who will probably manage, but who on the way up to adulthood will have a winding road, as she yearns for a love her father is not capable of giving her, and who therefore thinks it is okay to sit on the caretaker’s lap, even though he shakes so strangely and whispers “my girl” into her hair.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.999743446958124,
            "ai": 0.0001061451087005609,
            "paraphrased": 0.00015040793317545488
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00035401280738471937,
          "sentence": "In addition, we have the housewives who manage everything perfectly, and who use themselves as the measuring stick when they pass their strict, strict judgments on the others, who in their view clearly do not measure up.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9996459871926153,
            "ai": 0.0003428032929359325,
            "paraphrased": 0.000011209514448786883
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00006151846770267187,
          "sentence": "The book is divided into three.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999384815322974,
            "ai": 0.00005197500980101714,
            "paraphrased": 0.000009543457901654731
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00004998866534410644,
          "sentence": "In the first part we get to know all the families.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999500113346559,
            "ai": 0.00004010557516925442,
            "paraphrased": 0.00000988309017485202
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00005243793458797804,
          "sentence": "In the second part we follow a door-to-door salesman from door to door in the stairwell.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.999947562065412,
            "ai": 0.00004218828385686181,
            "paraphrased": 0.000010249650731116222
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00005023329416288363,
          "sentence": "He sells peepholes.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999497667058371,
            "ai": 0.00004025512246913929,
            "paraphrased": 0.000009978171693744346
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00006455328105208497,
          "sentence": "For nineteen kroner each family can have a peephole with wide-angle glass installed, so that they can see who is ringing the bell, and thus can choose not to open the door to just anyone.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.999935446718948,
            "ai": 0.00005490858485348277,
            "paraphrased": 0.000009644696198602194
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00004822311501146368,
          "sentence": "On his way up the floors, we get his interpretation of what he sees inside each of the flats.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999517768849885,
            "ai": 0.00003815119032473509,
            "paraphrased": 0.000010071924686728589
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00004915554724599758,
          "sentence": "In the final part, it is the housing cooperative’s growing rat problems that must be dealt with.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.999950844452754,
            "ai": 0.00003927371127759962,
            "paraphrased": 0.000009881835968397959
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00003676011350361302,
          "sentence": "I think one has to have lived a while to get the full benefit of this book, because its strength clearly lies in the easily recognizable elements from this period of history.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999632398864964,
            "ai": 0.000025674295800568097,
            "paraphrased": 0.000011085817703044923
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00003428760754988535,
          "sentence": "Otherwise I think one may well experience this book as a little boring, with the housewives mostly preoccupied with cleaning, cleaning and still more cleaning.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999657123924501,
            "ai": 0.000022069722209490855,
            "paraphrased": 0.000012217885340394497
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00004471376586886087,
          "sentence": "But that was how it was!",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999552862341311,
            "ai": 0.000035094966372722695,
            "paraphrased": 0.000009618799496138174
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00003449168616170596,
          "sentence": "And Anne B. Ragde has really done thorough research in order to write this book!",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999655083138383,
            "ai": 0.000022252297579256128,
            "paraphrased": 0.000012239388582449832
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00004930682827852094,
          "sentence": "Many times I found myself sitting and roaring with laughter at the funny character descriptions.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999506931717215,
            "ai": 0.00004042971407885716,
            "paraphrased": 0.000008877114199663775
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00005102557931912579,
          "sentence": "Like the woman who seriously considers having another child when her husband starts talking about closing down his office to save money, and sitting at home with his translations.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999489744206809,
