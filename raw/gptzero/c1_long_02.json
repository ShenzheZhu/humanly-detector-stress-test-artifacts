          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.0001824750551673672,
          "sentence": "I'm torn about this paper.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9998175249448327,
            "ai": 0.00016865910885738693,
            "paraphrased": 0.000013815946309980269
