      "sentences": [
        {
          "generated_prob": 0.00005487575946736277,
          "sentence": "This paper is methodologically very interesting, and just based on the methodological contribution I would vote for acceptance.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999451242405326,
            "ai": 0.0000405604098331861,
            "paraphrased": 0.000014315349634176663
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.000039562430770126734,
          "sentence": "However, the paper's sweeping claims of clearly beating existing baselines for TSP have been shown to not hold, with the local search method LK-H solving all the authors' instances to optimality -- in seconds on a CPU, compared to clearly suboptimal results by the authors' method in 25h on a GPU.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999604375692299,
            "ai": 0.00002261084080078457,
            "paraphrased": 0.000016951589969342166
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00004037487119951596,
          "sentence": "Seeing this clear dominance of the local search method LK-H, I find it irresponsible by the authors that they left Figure 1 as it is -- with the line for \"local search\" referring to an obviously poor implementation by Google rather than the LK-H local search method that everyone uses.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999596251288004,
            "ai": 0.000023418509849872145,
            "paraphrased": 0.000016956361349643812
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00003549514362075656,
          "sentence": "For example, at NIPS, I saw this Figure 1 being used in a talk (I am not sure anymore by whom, but I don't think it was by the authors), the narrative being \"RNNs now also clearly perform better than local search\".",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999645048563792,
            "ai": 0.00001534445845489138,
            "paraphrased": 0.000020150685165865178
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00004127442856656858,
          "sentence": "Of course, people would use a figure like that for that purpose, and it is clearly up to the authors to avoid such misconceptions.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999587255714334,
            "ai": 0.000023676062823227335,
            "paraphrased": 0.000017598365743341242
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00003629771021178068,
          "sentence": "The right course of action upon realizing the real strength of local search with LK-H would've been to make \"local search\" the same line as \"Optimal\", showing that the authors' method is still far worse than proper local search.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999637022897883,
            "ai": 0.000017756973823825955,
            "paraphrased": 0.000018540736387954722
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00005955265223607373,
          "sentence": "But the authors chose to leave the figure as it was, still suggesting that their method is far better than local search.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999404473477639,
            "ai": 0.00004390689787655099,
            "paraphrased": 0.00001564575435952274
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.000037451398473905325,
          "sentence": "Probably the authors didn't even think about this, but this of course will mislead the many superficial readers.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999625486015261,
            "ai": 0.000021296317145773867,
            "paraphrased": 0.000016155081328131455
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.000038685723999472685,
          "sentence": "To people outside of deep learning, this must look like a sensational yet obviously wrong claim.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999613142760005,
            "ai": 0.000023613369551138957,
            "paraphrased": 0.00001507235444833373
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00004492996557901806,
          "sentence": "I thus vote for rejection despite the interesting method.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.999955070034421,
            "ai": 0.00003181678804830457,
            "paraphrased": 0.000013113177530713488
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
