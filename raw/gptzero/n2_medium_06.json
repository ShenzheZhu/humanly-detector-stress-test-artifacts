          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999802710971614,
          "sentence": "It also reminds educators, parents, and individuals that success is not only about talent.",
          "perplexity": 0,
          "class_probabilities": {
