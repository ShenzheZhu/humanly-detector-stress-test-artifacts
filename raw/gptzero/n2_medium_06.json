          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999935146281941,
          "sentence": "Put simply, it means sticking with something because the goal matters enough to deserve repeated effort.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000006485371805876487,
            "ai": 0.9999709916167309,
