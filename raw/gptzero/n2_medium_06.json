      "sentences": [
        {
          "generated_prob": 0.9999920358538581,
          "sentence": "Grit is the ability to keep working toward a meaningful long-term goal when progress is slow, difficult, or discouraging.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007964146141870629,
            "ai": 0.9999729724131808,
