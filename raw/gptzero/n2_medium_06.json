          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999967914838624,
          "sentence": "It is shaped by habits, purpose, emotional resilience, and a willingness to keep learning over time.",
          "perplexity": 0,
