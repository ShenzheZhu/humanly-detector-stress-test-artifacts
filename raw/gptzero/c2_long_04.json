          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00007300239511330078,
          "sentence": "Although the questions asked by human experts in the human evaluation were not from the evaluation datasets, the paper should analyze how different those questions were from the questions present in the evaluation datasets.",
