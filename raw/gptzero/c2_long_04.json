        {
          "generated_prob": 0.0006041507997446242,
          "sentence": "Summary: The paper presents an approach—Neural Answer Construction Model—for the task of answering non-factoid questions, in particular, love-advice questions.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9993958492002554,
            "ai": 0.0005603838373270935,
            "paraphrased": 0.00004376696241753059
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00012261016445686552,
          "sentence": "The two main features of the proposed model are the following: 1) it incorporates the biases of semantics behind questions into word embeddings, and 2) in addition to optimizing for closeness between questions and answers, it also optimizes for the optimal combination of sentences in the predicted answer.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9998773898355431,
            "ai": 0.00009743929808613873,
            "paraphrased": 0.000025170866370726785
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00019287965992486665,
          "sentence": "The proposed model is evaluated using a dataset from a Japanese online QA service and is shown to outperform the baseline model (Tan et al.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9998071203400751,
            "ai": 0.00016361631687638199,
            "paraphrased": 0.00002926334304848466
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.0001511602218010677,
          "sentence": "2015) by 20% relatively (6% absolutely).",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9998488397781989,
            "ai": 0.00012315403693266533,
            "paraphrased": 0.000028006184868402368
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00013263425651165547,
          "sentence": "The paper also experiments with a few other baseline models, including ablations of the proposed model.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9998673657434883,
            "ai": 0.00010648079422990291,
            "paraphrased": 0.000026153462281752546
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00010759298517855272,
          "sentence": "Strengths:",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9998924070148214,
            "ai": 0.00008245427016460296,
            "paraphrased": 0.000025138715013949757
