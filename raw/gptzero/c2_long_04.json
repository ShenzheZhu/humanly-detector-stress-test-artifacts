          "highlight_sentence_for_ai": false,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00014123288990743578,
          "sentence": "2015) by 20% relatively (6% absolutely), which seems to be a significant improvement.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9998587671100926,
            "ai": 0.00011581618658586386,
            "paraphrased": 0.000025416703321571927
