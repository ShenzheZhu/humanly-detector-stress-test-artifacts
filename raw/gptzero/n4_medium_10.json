          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999924790717594,
          "sentence": "This might involve tolerating temporary discomfort, recovering from disappointment, or finding encouragement after failure.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007520928240660743,
            "ai": 0.9999733621871981,
