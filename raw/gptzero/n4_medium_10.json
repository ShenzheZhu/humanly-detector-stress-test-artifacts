          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999911911448363,
          "sentence": "Emotion also plays an important role.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008808855163663028,
            "ai": 0.9999735024830106,
            "paraphrased": 0.000017688661825655424
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999921214424544,
          "sentence": "Long-term goals often involve frustration, boredom, doubt, and anxiety, especially when improvement is not obvious.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007878557545570252,
            "ai": 0.9999732545759353,
            "paraphrased": 0.000018866866519097783
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999917253910044,
          "sentence": "People may begin with excitement, but that feeling usually fades.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008274608995515699,
