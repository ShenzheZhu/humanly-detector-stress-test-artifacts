          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9996122490421867,
          "sentence": "For example, someone who wants to run a marathon does not simply decide to run 42 kilometres one day.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00038775095781326335,
            "ai": 0.999601458433782,
            "paraphrased": 0.000010790608404732127
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9997698340329657,
          "sentence": "They begin with shorter distances, follow a training schedule, learn how to pace themselves, adjust their diet and sleep, and gradually increase their endurance.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00023016596703429883,
            "ai": 0.9997606757861321,
            "paraphrased": 0.00000915824683353663
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9998981852602327,
          "sentence": "Along the way, they may miss training sessions, experience muscle soreness, or feel discouraged.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00010181473976732395,
            "ai": 0.9998898707413563,
            "paraphrased": 0.00000831451887643225
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999162251689148,
          "sentence": "The goal becomes achievable because it is broken into smaller steps and supported by consistent routines.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00008377483108525417,
            "ai": 0.9999082185431885,
            "paraphrased": 0.000008006625726344868
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999242077048811,
          "sentence": "Prioritization is also important because long-term goals require trade-offs.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00007579229511892364,
            "ai": 0.9999166228395939,
            "paraphrased": 0.0000075848652871522
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999134362353075,
          "sentence": "Choosing to study for a degree may mean giving up some leisure time, spending money on education, or delaying other opportunities.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00008656376469252996,
            "ai": 0.9999049253081319,
            "paraphrased": 0.00000851092717560125
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
