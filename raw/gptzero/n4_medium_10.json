          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999926135954027,
          "sentence": "Pride after small accomplishments, hope about future success, and satisfaction from consistent effort can reinforce commitment.",
          "perplexity": 0,
          "class_probabilities": {
