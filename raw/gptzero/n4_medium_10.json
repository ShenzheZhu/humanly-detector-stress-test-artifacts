            "paraphrased": 0.000015938246125313068
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999989826584056,
          "sentence": "More often, progress comes from repeated actions that become part of daily life.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00001017341594402284,
            "ai": 0.9999730698443,
            "paraphrased": 0.000016756739755983592
