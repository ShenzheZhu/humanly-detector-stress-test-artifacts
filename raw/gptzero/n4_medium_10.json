          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999518690202486,
          "sentence": "It often depends on setting clear aims, building supportive habits, managing emotions, learning from setbacks, and staying connected to a meaningful reason for continuing.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00004813097975141309,
