          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999915121868732,
          "sentence": "Learning and behavior are closely connected to long-term goals because achievement requires building skills and habits over time.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008487813126789795,
            "ai": 0.9999740367296042,
