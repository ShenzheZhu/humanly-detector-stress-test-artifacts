        },
        {
          "generated_prob": 0.9999914945829345,
          "sentence": "Unlike a short-term goal, such as finishing a homework task tonight, a long-term goal involves persistence through changing circumstances, distractions, setbacks, and periods of low motivation.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00000850541706554642,
