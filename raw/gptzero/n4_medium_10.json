          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999925654479596,
          "sentence": "Motivation is central to long-term goal achievement because people need a reason to continue when progress is slow.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007434552040495031,
            "ai": 0.9999729872389458,
            "paraphrased": 0.000019578209013745644
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999929121261982,
          "sentence": "Some motivation comes from external rewards, such as earning a qualification, getting a job, or gaining recognition.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00000708787380178744,
            "ai": 0.9999724742435839,
            "paraphrased": 0.000020437882614291316
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999926380354495,
          "sentence": "However, long-term goals are often easier to maintain when they are also connected to internal reasons, such as personal values, curiosity, identity, or a sense of purpose.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007361964550558343,
