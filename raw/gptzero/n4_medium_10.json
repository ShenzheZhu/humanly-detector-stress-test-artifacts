          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999031870221882,
          "sentence": "Saying “I want to be healthier” may be inspiring, but saying “I will walk for 30 minutes after work four days a week” gives behavior a clear direction.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00009681297781189399,
