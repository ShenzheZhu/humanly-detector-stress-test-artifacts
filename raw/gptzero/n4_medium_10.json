          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999937912117912,
          "sentence": "Long-term goal achievement matters because many of the most meaningful outcomes in life depend on it.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00006208788208785866,
