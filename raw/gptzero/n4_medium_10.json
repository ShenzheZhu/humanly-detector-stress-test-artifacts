          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999923806309735,
          "sentence": "A student who wants to become a nurse may be motivated by the future career, but also by the belief that caring for others is meaningful.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000007619369026521007,
            "ai": 0.9999730397190094,
            "paraphrased": 0.00001934091196411448
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999919102163619,
          "sentence": "This deeper motivation can help sustain effort when the work becomes difficult.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008089783638160218,
            "ai": 0.9999735553632705,
            "paraphrased": 0.00001835485309140262
