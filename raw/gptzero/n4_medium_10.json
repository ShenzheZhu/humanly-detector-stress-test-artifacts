          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999908715538182,
          "sentence": "Successful goal achievement therefore depends not only on motivation, but also on managing emotions.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000009128446181800402,
            "ai": 0.9999737265224453,
            "paraphrased": 0.00001714503137289819
