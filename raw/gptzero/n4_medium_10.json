          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.999888639901148,
          "sentence": "Clear goals help people decide what to prioritize, while vague goals are easier to abandon.",
          "perplexity": 0,
          "class_probabilities": {
