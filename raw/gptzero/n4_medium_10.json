          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999895274871793,
          "sentence": "A person rarely reaches a major goal through one dramatic effort.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000010472512820698657,
