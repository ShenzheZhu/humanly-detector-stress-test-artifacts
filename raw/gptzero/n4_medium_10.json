          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999911651072165,
          "sentence": "In plain language, it is the ability to keep moving toward something important even when the reward is far away.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000008834892783499681,
            "ai": 0.9999744055803592,
