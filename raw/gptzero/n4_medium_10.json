          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999470865752424,
          "sentence": "Education, career development, physical health, financial stability, creative skill, and strong relationships all require effort over time.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00005291342475758919,
            "ai": 0.9999388075889873,
            "paraphrased": 0.000008278986255078861
          },
