          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9998810146286297,
          "sentence": "Understanding how long-term goals work helps people become more realistic and compassionate toward themselves.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00011898537137029422,
            "ai": 0.9998726795635667,
            "paraphrased": 0.000008335065062919032
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
          "interpretability_designation": null,
          "interpretability_alpha": null,
          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999114205336709,
          "sentence": "It shows that success is not simply a matter of willpower or talent.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.0000885794663291185,
            "ai": 0.999903810536748,
            "paraphrased": 0.0000076099969228779425
          },
          "interpretability_value": null,
          "interpretability_normalized_value": null,
