          "highlight_sentence_for_ai": true,
          "special_highlight_type": null
        },
        {
          "generated_prob": 0.9999065117491442,
          "sentence": "Each small decision either supports or weakens the larger goal.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.00009348825085576483,
            "ai": 0.9998978656184205,
            "paraphrased": 0.00000864613072373277
          },
          "interpretability_value": null,
