        {
          "generated_prob": 0.9999887718489295,
          "sentence": "Long-term goal achievement refers to the process of working toward an outcome that requires sustained effort over weeks, months, or years.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.000011228151070426664,
