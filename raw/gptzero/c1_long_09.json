          "special_highlight_type": null
        },
        {
          "generated_prob": 0.00007262157865049538,
          "sentence": "- Although in general the method is explained well some training details are missing.",
          "perplexity": 0,
          "class_probabilities": {
            "human": 0.9999273784213495,
